generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Installation {
  id              String          @id @default(uuid())
  githubInstallId Int             @unique
  account         String
  createdAt       DateTime        @default(now())
  reviews         ReviewSession[]
  ciRuns          CIRun[]
  users           User[]          @relation("UserInstallations")
}

// A logged-in dashboard user, identified by their GitHub account.
// Linked to every Installation that GitHub's `/user/installations`
// endpoint says they're allowed to see (owner or org member with access).
model User {
  id            String         @id @default(uuid())
  githubUserId  Int            @unique
  login         String
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  installations Installation[] @relation("UserInstallations")
}

model ReviewSession {
  id             String          @id @default(uuid())
  installation   Installation    @relation(fields: [installationId], references: [id], onDelete: Cascade)
  installationId String
  owner          String
  repo           String
  pullNumber     Int
  commitSha      String
  status         String          @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED
  summary        String?         // synthesized review verdict from the 4th LLM call
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  comments       ReviewComment[]

  @@unique([owner, repo, pullNumber, commitSha]) // dedup: same commit won't be reviewed twice
}

model ReviewComment {
  id              String        @id @default(uuid())
  session         ReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId       String
  file            String
  line            Int
  severity        String
  category        String
  title           String?       // one-line agent summary of the finding
  message         String
  currentCode     String?       // the exact flagged line(s), for display in the dashboard
  suggestion      String?       // the agent's proposed fix, as code
  blocking        Boolean       @default(false)
  githubCommentId BigInt?
  createdAt       DateTime      @default(now())
}

// A single GitHub Actions workflow run that failed and was triaged by the
// CI worker. Scoped to an installation like everything else.
model CIRun {
  id              String        @id @default(uuid())
  installation    Installation  @relation(fields: [installationId], references: [id], onDelete: Cascade)
  installationId  String
  owner           String
  repo            String
  workflowRunId   BigInt        @unique
  workflowName    String
  headSha         String
  pullNumber      Int?          // null when the run isn't tied to an open PR (e.g. fork PR, or push with no PR)
  status          String        @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED
  classification  String?       // BUILD_ERROR | TEST_FAILURE | LINT | TIMEOUT | FLAKY | UNKNOWN
  summary         String?
  postedCommentId BigInt?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}