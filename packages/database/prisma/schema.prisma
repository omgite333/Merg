generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Installation {
  id             String   @id @default(uuid())
  githubInstallId Int     @unique
  account        String
  createdAt      DateTime @default(now())
  reviews        ReviewSession[]
}

model ReviewSession {
  id             String          @id @default(uuid())
  installation   Installation    @relation(fields: [installationId], references: [id], onDelete: Cascade)
  installationId String
  owner          String
  repo           String
  pullNumber     Int
  commitSha      String
  status         String          @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED
  summary        String?         // synthesized review verdict from the 4th LLM call
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  comments       ReviewComment[]

  @@unique([owner, repo, pullNumber, commitSha])
}

model ReviewComment {
  id              String        @id @default(uuid())
  session         ReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId       String
  file            String
  line            Int
  severity        String
  category        String
  title           String?       // one-line agent summary of the finding
  message         String
  currentCode     String?       // the exact flagged line(s), for display in the dashboard
  suggestion      String?       // the agent's proposed fix, as code
  blocking        Boolean       @default(false)
  githubCommentId BigInt?
  createdAt       DateTime      @default(now())
}