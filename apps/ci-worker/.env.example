# Redis connection used by the BullMQ worker. Required — this service has no
# localhost fallback, so a typo here stops the process at boot.
REDIS_URL=redis://localhost:6379

# Database connection, read by Prisma (packages/database/prisma/schema.prisma).
# Neon: use the "pooled" string (host contains "-pooler") to run, the "direct"
# one for migrations. ?sslmode=require is mandatory.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/merg?sslmode=require

# GitHub App identity (Settings > Developer settings > GitHub Apps > <your app>).
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./github-app-private-key.pem

# The CI triage model is wired directly to Groq — there is no failover chain in
# this service, so this key is required.
GROQ_API_KEY=
