PORT=8000

# Origin of the web app — only this origin may make credentialed (cookie-bearing) requests.
# Must be a full origin with a scheme: "localhost:3000" is rejected at boot.
WEB_ORIGIN=http://localhost:3000

# Neon (Settings > Connection Details in the Neon console). Use the "pooled"
# connection string (host contains "-pooler") to run the app, and the "direct"
# one for `bun run --filter @repo/database db:migrate:deploy`.
# ?sslmode=require is mandatory — Neon serves TLS with a certificate that will
# not validate without it.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/merg?sslmode=require

# Redis is not hosted for us, so this one is local — `docker compose up -d`.
REDIS_URL=redis://localhost:6379

# GitHub App webhook secret (Settings > Developer settings > GitHub Apps > <your app>).
# The server only verifies inbound signatures, so it needs the secret — not the
# App ID or private key, which the worker uses to post reviews.
GITHUB_WEBHOOK_SECRET=

# Same value as apps/web/.env's AUTH_JWT_SECRET — this is what lets the
# server verify the session cookie the web app issued.
# Must be at least 16 characters: generate one with `openssl rand -hex 32`.
AUTH_JWT_SECRET=
