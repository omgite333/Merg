PORT=8000

# Origin of the web app — only this origin may make credentialed (cookie-bearing) requests.
# Must be a full origin with a scheme: "localhost:3000" is rejected at boot.
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://user:password@localhost:5432/merg
REDIS_URL=redis://localhost:6379

# GitHub App webhook secret (Settings > Developer settings > GitHub Apps > <your app>).
# The server only verifies inbound signatures, so it needs the secret — not the
# App ID or private key, which the worker uses to post reviews.
GITHUB_WEBHOOK_SECRET=

# Same value as apps/web/.env's AUTH_JWT_SECRET — this is what lets the
# server verify the session cookie the web app issued.
# Must be at least 16 characters: generate one with `openssl rand -hex 32`.
AUTH_JWT_SECRET=
