# Redis connection used by the BullMQ worker.
REDIS_URL=redis://localhost:6379

# Database connection, read by Prisma (packages/database/prisma/schema.prisma).
DATABASE_URL=postgresql://user:password@localhost:5432/merg

# GitHub App identity (Settings > Developer settings > GitHub Apps > <your app>).
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./github-app-private-key.pem

# LLM providers. At least one of these is required; the rest are optional
# failovers, tried in LLM_PROVIDER_ORDER. Leave a key out entirely to skip it —
# setting it blank is rejected at boot.
GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Comma-separated failover order. Only these ids are accepted: groq, gemini, openai.
# Defaults to groq,gemini,openai.
# LLM_PROVIDER_ORDER=groq,gemini,openai

# Per-provider request timeout in ms before failing over. Default 60000.
# LLM_TIMEOUT_MS=60000

# Override a provider's model id. Optional.
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini
