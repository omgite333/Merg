# Backend API the Next.js rewrite in next.config.ts proxies /api/* to.
API_ORIGIN=http://localhost:8000

# Public URL of this app itself — used to build the GitHub OAuth callback URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub App "Public page" install link (Settings > Developer settings > GitHub Apps > <your app>).
NEXT_PUBLIC_GITHUB_APP_INSTALL_URL=https://github.com/apps/YOUR-APP-SLUG/installations/select_target

# From your GitHub App's "General" settings page.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Any long random string. Must be the SAME value as AUTH_JWT_SECRET in apps/server/.env
# — both sides sign/verify the same session cookie. Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=

# Needed because the OAuth callback route (app/api/auth/github/callback) writes
# the User/Installation link directly via @repo/database — same value as
# apps/server/.env's DATABASE_URL. Neon: use the "pooled" string (host contains
# "-pooler") to run, the "direct" one for migrations. ?sslmode=require is mandatory.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/merg?sslmode=require